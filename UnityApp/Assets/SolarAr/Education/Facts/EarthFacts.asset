    _order: 1
    _visual: {fileID: 0}
  - _id: earth-02-known-life
    _title: Casa da vida
    _description: "A Terra \xE9 o \xFAnico mundo onde sabemos que existe vida."
    _category: 7
    _order: 2
    _visual: {fileID: 0}
  - _id: earth-03-moving-plates
    _title: Planeta inquieto
    _description: "Grandes placas da crosta se movem lentamente e mudam a superf\xEDcie."
    _category: 1
    _order: 3
    _visual: {fileID: 0}
  - _id: earth-04-magnetic-shield
    _title: "Escudo invis\xEDvel"
    _description: "O campo magn\xE9tico ajuda a proteger o planeta de part\xEDculas vindas do Sol."
    _category: 5
    _order: 4
    _visual: {fileID: 0}
  - _id: earth-05-one-moon
    _title: Nossa Lua
    _description: "A Lua ajuda a produzir as mar\xE9s nos oceanos da Terra."
    _category: 4
    _order: 5
    _visual: {fileID: 0}
  - _id: earth-06-air-mixture
