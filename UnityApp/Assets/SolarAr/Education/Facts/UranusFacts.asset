  m_Script: {fileID: 11500000, guid: e7c111770bef4da1a064507cf5a873e5, type: 3}
  m_Name: UranusFacts
  m_EditorClassIdentifier: Assembly-CSharp::SolarAR.Education.PlanetFacts
  _planetKey: uranus
  _facts:
  - _id: uranus-01-sideways
    _title: Planeta deitado
    _description: Urano gira quase de lado, como uma bola rolando ao redor do Sol.
    _category: 0
    _order: 1
    _visual: {fileID: 0}
  - _id: uranus-02-long-year
    _title: Ano distante
    _description: Uma volta de Urano ao redor do Sol dura cerca de 84 anos terrestres.
    _category: 0
    _order: 2
    _visual: {fileID: 0}
  - _id: uranus-03-long-seasons
    _title: "Esta\xE7\xF5es gigantes"
    _description: "Cada esta\xE7\xE3o pode durar aproximadamente 21 anos da Terra."
    _category: 0
    _order: 3
    _visual: {fileID: 0}
  - _id: uranus-04-ice-giant
    _title: Gigante de gelo
    _description: "Seu interior cont\xE9m materiais como \xE1gua, metano e am\xF4nia sob grande press\xE3o."
    _category: 5
    _order: 4
    _visual: {fileID: 0}
  - _id: uranus-05-blue-green
    _title: Cor azul-esverdeada
    _description: "O g\xE1s metano da atmosfera ajuda a produzir sua cor."
    _category: 2
    _order: 5
    _visual: {fileID: 0}
  - _id: uranus-06-faint-rings
    _title: "An\xE9is escuros"
    _description: "Urano possui an\xE9is estreitos e pouco brilhantes."
    _category: 4
    _order: 6
    _visual: {fileID: 0}
  - _id: uranus-07-very-cold
    _title: Atmosfera gelada
    _description: "Urano possui algumas das temperaturas atmosf\xE9ricas mais baixas entre os planetas."
    _category: 3
    _order: 7
    _visual: {fileID: 0}
  - _id: uranus-08-tilted-magnet
    _title: "Campo magn\xE9tico inclinado"
    _description: "Seu campo magn\xE9tico \xE9 inclinado e n\xE3o fica bem no centro do planeta."
    _category: 5
    _order: 8
    _visual: {fileID: 0}
